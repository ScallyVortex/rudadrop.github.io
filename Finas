    <!-- JavaScript Logic -->
    <script>
        lucide.createIcons();

        // Theme Toggle Switch: WhiteVisual (Light) <-> ReallyVisuals (Dark)
        function toggleTheme() {
            const html = document.documentElement;
            const isLight = html.classList.contains('light');

            const logo = document.getElementById('brand-logo');
            const title = document.getElementById('brand-title');
            const heroGradient = document.getElementById('hero-gradient-text');
            const guiLogo = document.getElementById('gui-header-logo');
            const guiTitle = document.getElementById('gui-header-title');
            const footerLogo = document.getElementById('footer-logo');
            const footerTitle = document.getElementById('footer-title');

            const lightIcon = document.getElementById('theme-icon-light');
            const darkIcon = document.getElementById('theme-icon-dark');

            if (isLight) {
                // Switch to Dark Mode (ReallyVisuals)
                html.classList.remove('light');
                html.classList.add('dark');
                
                if (title) title.innerText = 'ReallyVisuals';
                if (guiTitle) guiTitle.innerText = 'ReallyVisuals';
                if (footerTitle) footerTitle.innerText = 'ReallyVisuals';
                if (logo) logo.innerText = 'RV';
                if (guiLogo) guiLogo.innerText = 'RV';
                if (footerLogo) footerLogo.innerText = 'RV';

                if (heroGradient) {
                    heroGradient.className = "text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-orange-500 to-amber-500";
                    heroGradient.innerText = "без компромиссов";
                }

                lightIcon.classList.remove('flex');
                lightIcon.classList.add('hidden');
                darkIcon.classList.remove('hidden');
                darkIcon.classList.add('flex');
            } else {
                // Switch to Light Mode (WhiteVisual)
                html.classList.remove('dark');
                html.classList.add('light');

                if (title) title.innerText = 'WhiteVisual';
                if (guiTitle) guiTitle.innerText = 'WhiteVisual';
                if (footerTitle) footerTitle.innerText = 'WhiteVisual';
                if (logo) logo.innerText = 'WV';
                if (guiLogo) guiLogo.innerText = 'WV';
                if (footerLogo) footerLogo.innerText = 'WV';

                if (heroGradient) {
                    heroGradient.className = "text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-slate-900";
                    heroGradient.innerText = "без лишнего шума";
                }

                darkIcon.classList.remove('flex');
                darkIcon.classList.add('hidden');
                lightIcon.classList.remove('hidden');
                lightIcon.classList.add('flex');
            }
        }

        // GUI Sidebar Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.client-tab').forEach(el => {
                el.classList.remove('bg-slate-900', 'dark:bg-orange-500', 'text-white', 'active-tab');
                el.classList.add('text-slate-500', 'dark:text-gray-400');
            });

            const activeBtn = document.getElementById(`tab-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-slate-900', 'dark:bg-orange-500', 'text-white', 'active-tab');
                activeBtn.classList.remove('text-slate-500', 'dark:text-gray-400');
            }
        }

        // Live Demo Customizer Updates
        function setHudColor(color) {
            document.getElementById('demo-hp-bar').style.backgroundColor = color;
        }

        function updateDemoPreview() {
            const showKeybinds = document.getElementById('demo-keybinds').checked;
            const showTarget = document.getElementById('demo-target').checked;

            const keybindsWidget = document.getElementById('demo-keybinds-widget');
            const targetWidget = document.getElementById('demo-target-widget');

            if (keybindsWidget) keybindsWidget.style.display = showKeybinds ? 'block' : 'none';
            if (targetWidget) targetWidget.style.display = showTarget ? 'flex' : 'none';
        }

        // FAQ Accordion Toggle
        function toggleFaq(button) {
            const content = button.nextElementSibling;
            const icon = button.querySelector('i');
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else {
                content.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        }

        // Modal Handler
        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.toggle('hidden');
            }
        }

        function buyPlan(planName, price) {
            document.getElementById('modal-title').innerText = `Покупка: ${planName}`;
            document.getElementById('modal-subtitle').innerText = `Стоимость подписки — ${price}`;
            toggleModal('auth-modal');
        }

        function handleAuthSubmit(event) {
            event.preventDefault();
            alert('Успешно! Перенаправление на страницу оплаты...');
            toggleModal('auth-modal');
        }
    </script>
</body>
</html>
