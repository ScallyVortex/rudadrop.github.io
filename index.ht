<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhiteDrop — Выбивай донат на популярных Minecraft серверах</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
        }

        body {
            background-color: #0b0e14;
            color: #ffffff;
            overflow-x: hidden;
        }

        /* HEADER */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            background: rgba(15, 20, 30, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 28px;
            font-weight: 900;
            letter-spacing: 1px;
            color: #fff;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.5);
        }

        .logo span { color: #00e5ff; }

        nav a {
            color: #a0a5b5;
            text-decoration: none;
            margin-left: 25px;
            font-weight: 600;
            transition: 0.3s;
        }

        nav a:hover { color: #00e5ff; }

        /* LIVE DROPS TICKER */
        .live-drops-container {
            background: rgba(18, 24, 38, 0.8);
            border-bottom: 2px solid #00e5ff22;
            padding: 15px 0;
            overflow: hidden;
        }

        .live-drops-title {
            text-align: center;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #00e5ff;
            margin-bottom: 10px;
        }

        .drops-wrapper {
            display: flex;
            gap: 15px;
            width: max-content;
            animation: scrollDrops 25s linear infinite;
        }

        .drops-wrapper:hover { animation-play-state: paused; }

        @keyframes scrollDrops {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .drop-card {
            background: linear-gradient(135deg, #182032 0%, #101624 100%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 8px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 210px;
        }

        .drop-card img {
            width: 32px;
            height: 32px;
            border-radius: 6px;
        }

        .drop-info { display: flex; flex-direction: column; }
        .drop-user { font-size: 13px; font-weight: 700; }
        .drop-item { font-size: 12px; font-weight: 800; }
        .drop-server { font-size: 10px; color: #7a8298; }

        /* FREE CASE SECTION */
        .free-case-section {
            max-width: 1200px;
            margin: 40px auto 20px;
            padding: 0 20px;
        }

        .free-case-card {
            background: linear-gradient(135deg, #1c273c 0%, #0f172a 100%);
            border: 2px solid #00e5ff;
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 0 30px rgba(0, 229, 255, 0.15);
            position: relative;
            overflow: hidden;
        }

        .free-badge {
            position: absolute;
            top: 15px;
            right: 20px;
            background: #00e5ff;
            color: #000;
            font-weight: 900;
            font-size: 12px;
            padding: 6px 14px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        /* CASE ROULETTE */
        .roulette-container {
            width: 100%;
            max-width: 700px;
            height: 110px;
            margin: 25px auto;
            background: #080c14;
            border-radius: 16px;
            border: 2px solid rgba(0, 229, 255, 0.3);
            position: relative;
            overflow: hidden;
        }

        .roulette-marker {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 4px;
            height: 100%;
            background: #ff4757;
            box-shadow: 0 0 10px #ff4757;
            z-index: 10;
        }

        .roulette-track {
            display: flex;
            gap: 10px;
            position: absolute;
            left: 0;
            top: 10px;
            transition: transform 5s cubic-bezier(0.15, 0.9, 0.2, 1);
        }

        .roulette-item {
            min-width: 90px;
            height: 90px;
            background: #151c2c;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
        }

        /* BUTTONS */
        .btn-spin {
            background: linear-gradient(90deg, #00e5ff, #0088ff);
            color: #000;
            font-weight: 900;
            font-size: 18px;
            padding: 16px 40px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-spin:hover:not(:disabled) {
            filter: brightness(1.2);
            box-shadow: 0 0 25px rgba(0, 229, 255, 0.5);
            transform: translateY(-2px);
        }

        .btn-spin:disabled {
            background: #2a3447;
            color: #7a8298;
            cursor: not-allowed;
            box-shadow: none;
        }

        .timer-text {
            margin-top: 12px;
            font-size: 14px;
            color: #ffaa00;
            font-weight: 700;
        }

        /* SERVERS SECTION */
        .servers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .server-card {
            background: linear-gradient(180deg, #151c2c 0%, #0d121d 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            position: relative;
            transition: 0.4s;
        }

        .server-card:hover {
            transform: translateY(-8px);
            border-color: #00e5ff;
        }

        .server-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; }
        .card-rw::before { background: #ff4757; }
        .card-ft::before { background: #ffa502; }
        .card-st::before { background: #9b59b6; }

        .server-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            font-weight: 900;
        }

        .card-rw .server-icon { background: linear-gradient(135deg, #ff4757, #ff6b81); }
        .card-ft .server-icon { background: linear-gradient(135deg, #ffa502, #eccc68); }
        .card-st .server-icon { background: linear-gradient(135deg, #8e44ad, #9b59b6); }

        .btn-open {
            width: 100%;
            padding: 14px 0;
            border: none;
            border-radius: 12px;
            font-weight: 800;
            font-size: 16px;
            cursor: pointer;
            color: #fff;
            transition: 0.3s;
            text-transform: uppercase;
            margin-top: 15px;
        }

        .card-rw .btn-open { background: linear-gradient(90deg, #ff4757, #ff6b81); }
        .card-ft .btn-open { background: linear-gradient(90deg, #ffaa00, #ffa502); }
        .card-st .btn-open { background: linear-gradient(90deg, #8e44ad, #9b59b6); }

        /* MODAL */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: #151c2c;
            border: 1px solid #00e5ff;
            padding: 35px;
            border-radius: 20px;
            text-align: center;
            max-width: 400px;
            width: 90%;
        }

        .modal-content input {
            width: 100%;
            padding: 12px;
            margin: 15px 0;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.1);
            background: #0b0e14;
            color: #fff;
            font-size: 16px;
            outline: none;
        }

        .btn-close {
            margin-top: 10px;
            background: transparent;
            border: none;
            color: #7a8298;
            cursor: pointer;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #505668;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 14px;
            margin-top: 50px;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">WHITE<span>DROP</span></div>
        <nav>
            <a href="#">Главная</a>
            <a href="#free-case">Бесплатный кейс</a>
            <a href="#servers">Серверы</a>
            <a href="#">Поддержка</a>
        </nav>
    </header>

    <!-- LIVE DROPS TICKER -->
    <div class="live-drops-container">
        <div class="live-drops-title">● Лента выбитых донатов (LIVE)</div>
        <div class="drops-wrapper" id="dropsWrapper"></div>
    </div>

    <!-- DAILY FREE CASE SECTION -->
    <section class="free-case-section" id="free-case">
        <div class="free-case-card">
            <div class="free-badge">Раз в 24 часа</div>
            <h2 style="font-size: 32px; font-weight: 900;">🎁 Ежедневный Бесплатный Кейс</h2>
            <p style="color: #7a8298; margin-top: 5px;">Заходи каждый день и забирай случайный донат совершенно бесплатно!</p>

            <div class="roulette-container">
                <div class="roulette-marker"></div>
                <div class="roulette-track" id="rouletteTrack"></div>
            </div>

            <button class="btn-spin" id="spinBtn" onclick="spinFreeCase()">Открыть бесплатно</button>
            <div class="timer-text" id="timerText"></div>
        </div>
    </section>

    <!-- SERVERS GRID -->
    <section class="servers-grid" id="servers">
        <div class="server-card card-rw">
            <div class="server-icon">RW</div>
            <h2>ReallyWorld</h2>
            <p style="color: #7a8298;">Выбей Дракона, Магистра или Властелина!</p>
            <button class="btn-open" onclick="openBuyModal('ReallyWorld')">Кейсы от 49 ₽</button>
        </div>

        <div class="server-card card-ft">
            <div class="server-icon">FT</div>
            <h2>FunTime</h2>
            <p style="color: #7a8298;">Получи Князя или Крушителя на ФанТайм!</p>
            <button class="btn-open" onclick="openBuyModal('FunTime')">Кейсы от 59 ₽</button>
        </div>

        <div class="server-card card-st">
            <div class="server-icon">ST</div>
            <h2>SpookyTime</h2>
            <p style="color: #7a8298;">Редкие привилегии для SpookyTime!</p>
            <button class="btn-open" onclick="openBuyModal('SpookyTime')">Кейсы от 39 ₽</button>
        </div>
    </section>

    <!-- MODAL WINDOW -->
    <div class="modal" id="modal">
        <div class="modal-content">
            <h3 id="modalTitle">Забрать выигрыш</h3>
            <p id="modalSub" style="color: #7a8298; font-size: 14px; margin-top: 5px;">Введите ваш ник в Minecraft:</p>
            <input type="text" id="usernameInput" placeholder="Ваш ник...">
            <button class="btn-spin" style="width: 100%; font-size: 16px; padding: 12px;" onclick="confirmClaim()">Забрать донат</button>
            <br>
            <button class="btn-close" onclick="closeModal()">Закрыть</button>
        </div>
    </div>

    <footer>
        <p>© 2026 WhiteDrop. Проект не связан с Mojang AB / Microsoft.</p>
    </footer>

    <script>
        // Данные предметов
        const prizeList = [
            { name: 'ВИП', color: '#2ed573' },
            { name: 'ПРЕМИУМ', color: '#1e90ff' },
            { name: 'КРЕАТИВ', color: '#eccc68' },
            { name: 'МАГИСТР', color: '#9b59b6' },
            { name: 'СПОНСОР', color: '#00e5ff' },
            { name: 'КНЯЗЬ', color: '#ffa502' },
            { name: 'ДРАКОН', color: '#ff4757' }
        ];

        const servers = ['ReallyWorld', 'FunTime', 'SpookyTime'];
        const nicknames = ['ProGamer2026', 'DarkKnight', 'FunTime_King', 'PvP_God', 'RW_Master', 'Minecraftik'];

        // Генерация бегущей строки
        const dropsWrapper = document.getElementById('dropsWrapper');
        let initialHTML = '';
        for (let i = 0; i < 20; i++) {
            const randNick = nicknames[Math.floor(Math.random() * nicknames.length)];
            const randItem = prizeList[Math.floor(Math.random() * prizeList.length)];
            const randServer = servers[Math.floor(Math.random() * servers.length)];
            initialHTML += `
                <div class="drop-card">
                    <img src="https://mc-heads.net/avatar/${randNick}/32" alt="${randNick}" onerror="this.src='https://mc-heads.net/avatar/Steve/32'">
                    <div class="drop-info">
                        <span class="drop-user">${randNick}</span>
                        <span class="drop-item" style="color: ${randItem.color}">${randItem.name}</span>
                        <span class="drop-server">${randServer}</span>
                    </div>
                </div>`;
        }
        dropsWrapper.innerHTML = initialHTML + initialHTML;

        // Построение рулетки бесплатного кейса
        const track = document.getElementById('rouletteTrack');
        let rouletteItems = [];

        function buildRoulette() {
            track.innerHTML = '';
            rouletteItems = [];
            // Заполняем ленту 60 предметами для долгим прокрутом
            for (let i = 0; i < 60; i++) {
                const randPrize = prizeList[Math.floor(Math.random() * prizeList.length)];
                rouletteItems.push(randPrize);
                const el = document.createElement('div');
                el.className = 'roulette-item';
                el.style.color = randPrize.color;
                el.style.borderColor = randPrize.color + '44';
                el.innerText = randPrize.name;
                track.appendChild(el);
            }
        }
        buildRoulette();

        // Система таймера 24 часа
        const COOLDOWN_TIME = 24 * 60 * 60 * 1000; // 24 часа в миллисекундах
        const spinBtn = document.getElementById('spinBtn');
        const timerText = document.getElementById('timerText');
        let wonItem = null;

        function checkCooldown() {
            const lastSpin = localStorage.getItem('whitedrop_last_spin');
            if (lastSpin) {
                const timePassed = Date.now() - parseInt(lastSpin);
                if (timePassed < COOLDOWN_TIME) {
                    const timeLeft = COOLDOWN_TIME - timePassed;
                    spinBtn.disabled = true;
                    updateTimerDisplay(timeLeft);
                    return true;
                }
            }
            spinBtn.disabled = false;
            spinBtn.innerText = 'Открыть бесплатно';
            timerText.innerText = '';
            return false;
        }

        function updateTimerDisplay(ms) {
            const hours = Math.floor(ms / (1000 * 60 * 60));
            const minutes = Math.floor((ms % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((ms % (1000 * 60)) / 1000);
            
            spinBtn.innerText = 'Кейс уже открыт';
            timerText.innerText = `Следующий бесплатный кейс через: ${hours}ч ${minutes}м ${seconds}с`;
        }

        setInterval(() => {
            const lastSpin = localStorage.getItem('whitedrop_last_spin');
            if (lastSpin) {
                const timePassed = Date.now() - parseInt(lastSpin);
                if (timePassed < COOLDOWN_TIME) {
                    updateTimerDisplay(COOLDOWN_TIME - timePassed);
                } else {
                    checkCooldown();
                }
            }
        }, 1000);

        // Вращение кейса
        function spinFreeCase() {
            if (checkCooldown()) return;

            spinBtn.disabled = true;
            buildRoulette();

            // Победитель — 45-й элемент в рулетке
            const winningIndex = 45;
            wonItem = rouletteItems[winningIndex];

            // Расчет сдвига рулетки
            const itemWidth = 100; // 90px ширина + 10px gap
            const containerWidth = document.querySelector('.roulette-container').offsetWidth;
            const targetOffset = (winningIndex * itemWidth) - (containerWidth / 2) + (itemWidth / 2);

            // Запуск анимации
            track.style.transition = 'transform 5s cubic-bezier(0.15, 0.9, 0.2, 1)';
            track.style.transform = `translateX(-${targetOffset}px)`;

            // Запоминаем время открытия
            localStorage.setItem('whitedrop_last_spin', Date.now().toString());

            setTimeout(() => {
                showWinModal(wonItem);
                checkCooldown();
            }, 5300);
        }

        // Модальное окно выигрыша и покупок
        function showWinModal(item) {
            document.getElementById('modalTitle').innerText = '🎉 Вы выиграли ' + item.name + '!';
            document.getElementById('modalSub').innerText = 'Выберите сервер и введите ник для получения:';
            document.getElementById('modal').style.display = 'flex';
        }

        function openBuyModal(serverName) {
            document.getElementById('modalTitle').innerText = 'Покупка кейса ' + serverName;
            document.getElementById('modalSub').innerText = 'Введите ваш ник на сервере:';
            document.getElementById('modal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('modal').style.display = 'none';
        }

        function confirmClaim() {
            const nick = document.getElementById('usernameInput').value;
            if (!nick.trim()) {
                alert('Пожалуйста, введите ваш ник в игре!');
                return;
            }
            alert(`Успешно! Донат зачислен на ник ${nick}.`);
            closeModal();
        }

        // Проверяем таймер при загрузке страницы
        checkCooldown();
    </script>
</body>
</html>
